---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, resolveLang, useTranslations, type Lang, type UIKey } from '../i18n/ui.ts';
import RarityLegend from './RarityLegend.astro';

// Shell do Cubo: sidebar com brand, navegação vertical, legenda de raridade e
// seletor de idioma. Vira topo empilhado no mobile.
const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const NAV: { path: string; key: UIKey }[] = [
  { path: '', key: 'nav.ranking' },
  { path: 'efeitos', key: 'nav.effects' },
  { path: 'farm', key: 'nav.farm' },
  { path: 'craft', key: 'nav.craft' },
  { path: 'bag', key: 'nav.bag' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/^\/(en)(?=\/|$)/, '').replace(/^\/+|\/+$/g, '');
const LOCALIZED = new Set(['', 'efeitos', 'farm', 'craft', 'bag']);
const switchPath = LOCALIZED.has(path) ? path : '';
const home = getRelativeLocaleUrl(lang, '');
---

<aside
  class="border-b border-line-soft bg-sidebar px-4 py-4 md:sticky md:top-0 md:h-screen md:overflow-y-auto md:border-r md:border-b-0"
>
  <!-- brand -->
  <a href={home} class="flex items-center gap-2">
    <span
      class="grid size-8 flex-none place-items-center rounded-[9px] text-[#06140f]"
      style="background:linear-gradient(135deg,#2dd4a7,#179478)"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
        <polyline points="16 7 22 7 22 13"></polyline>
      </svg>
    </span>
    <span class="leading-tight">
      <span class="block font-display text-sm font-semibold text-ink">TBH Market Tool</span>
      <span class="block text-[10px] text-hint">Itens × Mercado Steam</span>
    </span>
  </a>

  <div class="mt-4 md:mt-6">
    <div class="mb-2 text-[10px] tracking-wider text-hint uppercase">{t('nav.sectionNav')}</div>
    <nav class="flex flex-wrap gap-1 md:flex-col" aria-label="seções">
      {
        NAV.map((l) => {
          const active = path === l.path;
          return (
            <a
              href={getRelativeLocaleUrl(lang, l.path)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 text-sm transition-colors',
                active ? 'bg-accent/15 font-semibold text-accent' : 'text-muted hover:bg-row-hover hover:text-ink',
              ]}
            >
              {t(l.key)}
            </a>
          );
        })
      }
    </nav>
  </div>

  {
    Astro.slots.has('filters') && (
      <div class="mt-5">
        <div class="mb-2 text-[10px] tracking-wider text-hint uppercase">{t('nav.sectionFilters')}</div>
        <slot name="filters" />
      </div>
    )
  }

  <div class="mt-5 hidden md:block">
    <div class="mb-2 text-[10px] tracking-wider text-hint uppercase">{t('nav.sectionRarity')}</div>
    <RarityLegend />
  </div>

  <div class="mt-5 flex items-center gap-1" aria-label={t('nav.lang')}>
    {
      (Object.keys(languages) as Lang[]).map((lng) => (
        <a
          href={getRelativeLocaleUrl(lng, switchPath)}
          aria-current={lng === lang ? 'true' : undefined}
          class:list={[
            'rounded px-1.5 py-0.5 text-[11px] uppercase transition-colors',
            lng === lang ? 'bg-accent/15 text-ink' : 'text-muted hover:text-ink',
          ]}
        >
          {lng}
        </a>
      ))
    }
  </div>
</aside>
