---
import Layout from '../../layouts/Layout.astro';
import MarketFilters from '../market/MarketFilters.svelte';
import MercadoTable from '../market/MercadoTable.svelte';
import Freshness from '../market/Freshness.svelte';
import { loadMarket, loadMarketSlim } from '../../lib/data.ts';
import { GRADE_ORDER } from '../../lib/grades.ts';
import { attrLabel } from '../../lib/labels.ts';
import { resolveLang, useTranslations } from '../../i18n/ui.ts';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const items = loadMarketSlim();
const full = loadMarket();

// opções dos filtros (presentes nos dados)
const present = <T,>(arr: T[]) => [...new Set(arr.filter(Boolean))];
const options = {
  grades: [...GRADE_ORDER].reverse().filter((g) => items.some((it) => it.grade === g)),
  types: present(items.map((it) => it.type)).sort() as string[],
  gtypes: present(items.map((it) => it.gearType)).sort() as string[],
  classes: present(items.flatMap((it) => it.classes ?? [])).filter((c) => c !== 'All').sort() as string[],
  attrs: present(items.flatMap((it) => Object.keys(it.attrs ?? {}))).sort((a, b) => attrLabel(a).localeCompare(attrLabel(b))) as string[],
};

// frescor dos dados (maior fetchedAt de preço real/encomenda). A formatação fica
// no island Freshness (cliente), p/ idade relativa correta e fuso BRT — formatar
// aqui (build em UTC no CI) mostrava a hora/dia errados.
let maxFetched = 0;
for (const it of full) {
  maxFetched = Math.max(maxFetched, it.real?.brl?.fetchedAt ?? 0, it.book?.brl?.fetchedAt ?? 0);
}

const filterMsgs = {
  search: t('mercado.search'),
  allGrades: t('mercado.allGrades'),
  allTypes: t('filter.allTypes'),
  allGearTypes: t('filter.allGearTypes'),
  allClasses: t('filter.allClasses'),
  allAttrs: t('filter.allAttrs'),
  lvlMin: t('filter.lvlMin'),
  lvlMax: t('filter.lvlMax'),
  goldMin: t('filter.goldMin'),
  goldMax: t('filter.goldMax'),
  priceMin: t('filter.priceMin'),
  priceMax: t('filter.priceMax'),
  tradable: t('filter.tradable'),
  withOrders: t('filter.withOrders'),
  onlyFav: t('filter.onlyFav'),
  clear: t('filter.clear'),
};
const tableMsgs = {
  items: t('mercado.items'),
  viewTable: t('view.table'),
  viewCards: t('view.cards'),
  sortBy: t('sort.by'),
  movers: t('movers.label'),
  heroDeal: t('hero.deal'),
  heroCube: t('hero.cube'),
  cols: {
    name: t('col.item'), grade: t('col.grade'), gearType: t('col.type'), classes: t('col.class'),
    level: t('col.lvl'), gold: t('col.gold'), price: t('col.price'), chg24: t('col.delta'),
    goldPer: t('col.goldPer'), listings: t('col.listings'), vol: t('col.vol'),
    buyMax: t('col.buyMax'), buyNet: t('col.net'), buyOrders: t('col.orders'),
  },
};
const bagHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${lang === 'pt' ? '' : '/en'}/bag`;
---

<Layout title={`${t('mercado.title')} — TBH Market`} description={t('mercado.subtitle')}>
  <MarketFilters slot="filters" client:only="svelte" options={options} msgs={filterMsgs} />

  <main class="mx-auto max-w-6xl px-4 py-6">
    <header class="mb-4 flex flex-wrap items-end justify-between gap-2">
      <div>
        <h1 class="display text-2xl font-semibold text-ink">{t('mercado.title')}</h1>
        <p class="mt-1 text-sm text-muted">{items.length} {t('mercado.items')}. {t('mercado.subtitle')}</p>
      </div>
      <div class="flex items-center gap-3 text-xs text-hint">
        {maxFetched > 0 && <Freshness epoch={maxFetched} lang={lang} client:only="svelte" />}
        <a href={bagHref} class="rounded-md border border-line bg-field px-2.5 py-1.5 text-muted hover:text-ink">{t('nav.bag')}</a>
      </div>
    </header>

    <MercadoTable client:only="svelte" items={items} msgs={tableMsgs} />
  </main>
</Layout>
