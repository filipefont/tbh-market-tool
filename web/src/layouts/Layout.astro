---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import CuboSidebar from '../components/CuboSidebar.astro';
import { resolveLang } from '../i18n/ui.ts';

interface Props {
  title?: string;
  description?: string;
  /** false oculta a sidebar do Cubo (raro). */
  nav?: boolean;
}

const { title = 'TBH Market — next', description, nav = true } = Astro.props;
const lang = resolveLang(Astro.currentLocale);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

// hreflang só p/ as rotas com versão localizada (PT/EN). Páginas só-PT (ex.: /item)
// não emitem alternates.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname
  .replace(base, '')
  .replace(/^\/(en)(?=\/|$)/, '')
  .replace(/^\/+|\/+$/g, '');
const LOCALIZED = new Set(['', 'efeitos', 'farm', 'craft', 'bag']);
const alternates = LOCALIZED.has(path)
  ? [
      { hreflang: 'pt-BR', href: getAbsoluteLocaleUrl('pt', path) },
      { hreflang: 'en', href: getAbsoluteLocaleUrl('en', path) },
      { hreflang: 'x-default', href: getAbsoluteLocaleUrl('pt', path) },
    ]
  : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <title>{title}</title>
  </head>
  <body class={nav ? 'md:grid md:min-h-screen md:grid-cols-[248px_minmax(0,1fr)]' : ''}>
    {
      nav && (
        <CuboSidebar>
          <slot name="filters" slot="filters" />
        </CuboSidebar>
      )
    }
    <div class="min-w-0">
      <slot />
    </div>
  </body>
</html>
