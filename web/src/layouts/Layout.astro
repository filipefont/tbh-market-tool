---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import CuboSidebar from '../components/CuboSidebar.astro';
import { resolveLang } from '../i18n/ui.ts';

interface Props {
  title?: string;
  description?: string;
  /** false oculta a sidebar do Cubo (raro). */
  nav?: boolean;
}

const { title = 'TBH Market — next', description, nav = true } = Astro.props;
const lang = resolveLang(Astro.currentLocale);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
const home = getRelativeLocaleUrl(lang, '');

// hreflang só p/ as rotas com versão localizada (PT/EN). Páginas só-PT (ex.: /item)
// não emitem alternates.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname
  .replace(base, '')
  .replace(/^\/(en)(?=\/|$)/, '')
  .replace(/^\/+|\/+$/g, '');
const LOCALIZED = new Set(['', 'efeitos', 'farm', 'craft', 'bag']);
const alternates = LOCALIZED.has(path)
  ? [
      { hreflang: 'pt-BR', href: getAbsoluteLocaleUrl('pt', path) },
      { hreflang: 'en', href: getAbsoluteLocaleUrl('en', path) },
      { hreflang: 'x-default', href: getAbsoluteLocaleUrl('pt', path) },
    ]
  : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    {
      nav && (
        <header class="flex items-center justify-between gap-3 border-b border-line-soft bg-sidebar px-4 py-2.5">
          <a href={home} class="flex items-center gap-2">
            <span
              class="grid size-8 flex-none place-items-center rounded-[9px] text-[#06140f]"
              style="background:linear-gradient(135deg,#2dd4a7,#179478)"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                <polyline points="16 7 22 7 22 13" />
              </svg>
            </span>
            <span class="leading-tight">
              <span class="block font-display text-sm font-semibold text-ink">TBH Market Tool</span>
              <span class="block text-[10px] text-hint">Itens × Mercado Steam</span>
            </span>
          </a>
          <div class="flex items-center gap-3 text-xs text-hint">
            <slot name="topbar" />
          </div>
        </header>
      )
    }
    <div class={nav ? 'md:grid md:grid-cols-[248px_minmax(0,1fr)]' : ''}>
      {
        nav && (
          <CuboSidebar>
            <slot name="search" slot="search" />
            <slot name="filters" slot="filters" />
          </CuboSidebar>
        )
      }
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </body>
</html>
