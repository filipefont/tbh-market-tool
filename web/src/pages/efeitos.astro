---
import Layout from '../layouts/Layout.astro';
import EffectCard from '../components/ds/EffectCard.svelte';
import { loadGems } from '../lib/data.ts';

// Aba Efeitos: gemas e seus efeitos por slot. Rota estática (SSG, SEO-ready).
const gems = loadGems().sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="Efeitos — TBH Market"
  description="Gemas do Taskbar Hero e seus efeitos por slot (arma, armadura, acessório), com preço de mercado."
>
  <main class="mx-auto max-w-5xl px-4 py-8">
    <header class="mb-5">
      <h1 class="text-xl font-semibold text-ink">Efeitos</h1>
      <p class="mt-1 text-sm text-muted">
        {gems.length} gemas e seus efeitos por slot, com o preço de mercado.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {gems.map((item) => <EffectCard item={item} />)}
    </div>
  </main>
</Layout>
