---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ds/Badge.svelte';
import Chip from '../components/ds/Chip.svelte';
import Delta from '../components/ds/Delta.svelte';
import GradeBadge from '../components/ds/GradeBadge.svelte';
import Showcase from '../components/ds/Showcase.svelte';
import { GRADE_ORDER } from '../lib/grades.ts';
import type { HistorySeries, MarketItem } from '../lib/contract/index.ts';

// Storybook-like: usa as amostras das fixtures (mesmos dados do contrato).
import dataFixture from '../../tests/fixtures/data.json';
import histFixture from '../../tests/fixtures/history.json';

const items = dataFixture as unknown as MarketItem[];
const series = (Object.values(histFixture)[0] ?? []) as unknown as HistorySeries;

const sectionCls = 'space-y-3 border-t border-line pt-6';
const h2Cls = 'text-sm font-semibold text-ink';
const labelCls = 'text-xs text-muted';
---

<Layout title="Design System — showcase (Fase 1)">
  <main class="mx-auto max-w-4xl space-y-8 px-6 py-12">
    <header>
      <span class="inline-block rounded-full border border-line bg-surface px-2 py-0.5 text-xs text-muted">
        Etapa 4 · Fase 1 · design system v2
      </span>
      <h1 class="mt-3 text-2xl font-semibold text-ink">Componentes base</h1>
      <p class="mt-1 max-w-prose text-sm text-muted">
        Identidade "Cubo" consolidada em componentes reutilizáveis (Svelte + Tailwind).
        Dados das amostras do contrato (<code class="tabular text-link">tests/fixtures</code>).
      </p>
    </header>

    <section class={sectionCls}>
      <h2 class={h2Cls}>Raridade (grades)</h2>
      <div class="flex flex-wrap gap-2">
        {GRADE_ORDER.map((g) => <GradeBadge grade={g} />)}
      </div>
      <div class="flex flex-wrap gap-4">
        {GRADE_ORDER.map((g) => <GradeBadge grade={g} dot />)}
      </div>
    </section>

    <section class={sectionCls}>
      <h2 class={h2Cls}>Selos</h2>
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="live">AO VIVO</Badge>
        <Badge variant="new">NOVO</Badge>
        <Badge variant="lock" title="intradável">🔒 trava</Badge>
        <Badge variant="craft">CRAFTAR</Badge>
        <Badge variant="gamble">APOSTAR</Badge>
        <Badge variant="sell">VENDER</Badge>
        <Badge variant="neutral">neutro</Badge>
      </div>
    </section>

    <section class={sectionCls}>
      <h2 class={h2Cls}>Variação (Δ)</h2>
      <div class="flex flex-wrap items-center gap-4">
        <Delta pct={3.2} suffix="24h" />
        <Delta pct={-1.4} suffix="24h" />
        <Delta pct={0} suffix="24h" />
        <Delta pct={null} />
      </div>
    </section>

    <section class={sectionCls}>
      <h2 class={h2Cls}>Chips</h2>
      <div class="flex flex-wrap items-center gap-2">
        <Chip>estático</Chip>
        <Chip active>ativo</Chip>
      </div>
      <p class={labelCls}>(chips clicáveis recebem <code class="tabular">onclick</code> e viram botões)</p>
    </section>

    <section class={sectionCls}>
      <h2 class={h2Cls}>Cards + gráfico (interativo)</h2>
      <Showcase client:only="svelte" {items} {series} />
    </section>
  </main>
</Layout>
